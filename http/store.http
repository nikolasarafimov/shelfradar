@baseUrl = http://localhost:8080


### Marko login

POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "marko@shelfradar.local",
  "password": "Store123!"
}

> {%
    client.global.set(
        "marko_token",
        response.body.accessToken
    );
%}


### Marko stores

GET {{baseUrl}}/api/store/stores
Authorization: Bearer {{marko_token}}
Accept: application/json

> {%
    if (response.body.length > 0) {
        client.global.set(
            "marko_store_id",
            response.body[0].id
        );
    }
%}


### Marko store details

GET {{baseUrl}}/api/store/stores/{{marko_store_id}}
Authorization: Bearer {{marko_token}}
Accept: application/json


### Update Marko store

PUT {{baseUrl}}/api/store/stores/{{marko_store_id}}
Authorization: Bearer {{marko_token}}
Content-Type: application/json

{
  "name": "Market Center",
  "address": "Macedonia Square 1",
  "city": "Skopje",
  "latitude": 41.998100,
  "longitude": 21.425400,
  "phone": "+389 2 555 1001",
  "workingHours": "Mon-Sun 08:00-22:00"
}


### Marko inventory

GET {{baseUrl}}/api/store/stores/{{marko_store_id}}/inventory?page=0&size=20&sort=nameAsc
Authorization: Bearer {{marko_token}}
Accept: application/json

> {%
    if (
        response.body.content &&
        response.body.content.length > 0
    ) {
        client.global.set(
            "existing_inventory_id",
            response.body.content[0].id
        );
    }
%}


### Search inventory

GET {{baseUrl}}/api/store/stores/{{marko_store_id}}/inventory?q=coca&page=0&size=20&sort=nameAsc
Authorization: Bearer {{marko_token}}
Accept: application/json


### Sort price ascending

GET {{baseUrl}}/api/store/stores/{{marko_store_id}}/inventory?page=0&size=20&sort=priceAsc
Authorization: Bearer {{marko_token}}
Accept: application/json


### Sort price descending

GET {{baseUrl}}/api/store/stores/{{marko_store_id}}/inventory?page=0&size=20&sort=priceDesc
Authorization: Bearer {{marko_token}}
Accept: application/json


### Sort by last update

GET {{baseUrl}}/api/store/stores/{{marko_store_id}}/inventory?page=0&size=20&sort=updatedDesc
Authorization: Bearer {{marko_token}}
Accept: application/json


### Product catalog for store owner

GET {{baseUrl}}/api/store/catalog/products?page=0&size=50
Authorization: Bearer {{marko_token}}
Accept: application/json


### Find Milka

GET {{baseUrl}}/api/store/catalog/products?q=Milka&page=0&size=50
Authorization: Bearer {{marko_token}}
Accept: application/json

> {%
    if (
        response.body.content &&
        response.body.content.length > 0
    ) {
        client.global.set(
            "test_product_id",
            response.body.content[0].id
        );
    }
%}


### Add Milka to inventory

POST {{baseUrl}}/api/store/stores/{{marko_store_id}}/inventory
Authorization: Bearer {{marko_token}}
Content-Type: application/json

{
  "productId": {{test_product_id}},
  "price": 69.00,
  "quantity": 15,
  "status": "IN_STOCK"
}

> {%
    if (response.status === 201) {
        client.global.set(
            "test_inventory_id",
            response.body.id
        );
    }
%}


### Add duplicate inventory item - expected 409

POST {{baseUrl}}/api/store/stores/{{marko_store_id}}/inventory
Authorization: Bearer {{marko_token}}
Content-Type: application/json

{
  "productId": {{test_product_id}},
  "price": 71.00,
  "quantity": 10,
  "status": "IN_STOCK"
}


### Update test inventory

PUT {{baseUrl}}/api/store/stores/{{marko_store_id}}/inventory/{{test_inventory_id}}
Authorization: Bearer {{marko_token}}
Content-Type: application/json

{
  "price": 72.50,
  "quantity": 8,
  "status": "LOW_STOCK"
}


### Invalid: quantity 0 with IN_STOCK

PUT {{baseUrl}}/api/store/stores/{{marko_store_id}}/inventory/{{test_inventory_id}}
Authorization: Bearer {{marko_token}}
Content-Type: application/json

{
  "price": 72.50,
  "quantity": 0,
  "status": "IN_STOCK"
}


### Invalid: quantity 0 with LOW_STOCK

PUT {{baseUrl}}/api/store/stores/{{marko_store_id}}/inventory/{{test_inventory_id}}
Authorization: Bearer {{marko_token}}
Content-Type: application/json

{
  "price": 72.50,
  "quantity": 0,
  "status": "LOW_STOCK"
}


### Invalid: quantity > 0 with OUT_OF_STOCK

PUT {{baseUrl}}/api/store/stores/{{marko_store_id}}/inventory/{{test_inventory_id}}
Authorization: Bearer {{marko_token}}
Content-Type: application/json

{
  "price": 72.50,
  "quantity": 10,
  "status": "OUT_OF_STOCK"
}


### Valid OUT_OF_STOCK

PUT {{baseUrl}}/api/store/stores/{{marko_store_id}}/inventory/{{test_inventory_id}}
Authorization: Bearer {{marko_token}}
Content-Type: application/json

{
  "price": 72.50,
  "quantity": 0,
  "status": "OUT_OF_STOCK"
}


### Restore to LOW_STOCK

PUT {{baseUrl}}/api/store/stores/{{marko_store_id}}/inventory/{{test_inventory_id}}
Authorization: Bearer {{marko_token}}
Content-Type: application/json

{
  "price": 72.50,
  "quantity": 5,
  "status": "LOW_STOCK"
}


### Invalid negative price

PUT {{baseUrl}}/api/store/stores/{{marko_store_id}}/inventory/{{test_inventory_id}}
Authorization: Bearer {{marko_token}}
Content-Type: application/json

{
  "price": -10.00,
  "quantity": 5,
  "status": "LOW_STOCK"
}


### Invalid negative quantity

PUT {{baseUrl}}/api/store/stores/{{marko_store_id}}/inventory/{{test_inventory_id}}
Authorization: Bearer {{marko_token}}
Content-Type: application/json

{
  "price": 72.50,
  "quantity": -1,
  "status": "LOW_STOCK"
}


### Non-existing product

POST {{baseUrl}}/api/store/stores/{{marko_store_id}}/inventory
Authorization: Bearer {{marko_token}}
Content-Type: application/json

{
  "productId": 999999999,
  "price": 100.00,
  "quantity": 5,
  "status": "IN_STOCK"
}


