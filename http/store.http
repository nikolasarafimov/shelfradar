@baseUrl = http://localhost:8080


### ========================================================
### MARKO LOGIN
### Expected: 200
### ========================================================

POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "marko@shelfradar.local",
  "password": "Store123!"
}

> {%
    client.global.set(
        "marko_token",
        response.body.accessToken
    );
%}


### ========================================================
### MARKO STORES
### Expected: 200
### ========================================================

GET {{baseUrl}}/api/store/stores
Authorization: Bearer {{marko_token}}
Accept: application/json

> {%
    if (
        response.body &&
        response.body.length > 0
    ) {
        client.global.set(
            "marko_store_id",
            response.body[0].id
        );
    }
%}


### ========================================================
### MARKO STORE DETAILS
### Expected: 200
### ========================================================

GET {{baseUrl}}/api/store/stores/{{marko_store_id}}
Authorization: Bearer {{marko_token}}
Accept: application/json


### ========================================================
### UPDATE MARKO STORE PROFILE
### Expected: 200
### ========================================================

PUT {{baseUrl}}/api/store/stores/{{marko_store_id}}
Authorization: Bearer {{marko_token}}
Content-Type: application/json

{
  "name": "Market Center",
  "address": "Macedonia Square 1",
  "city": "Skopje",
  "latitude": 41.998100,
  "longitude": 21.425400,
  "phone": "+389 2 555 1001",
  "workingHours": "Mon-Sun 08:00-22:00"
}


### ========================================================
### MARKO INVENTORY
### Expected: 200
### ========================================================

GET {{baseUrl}}/api/store/stores/{{marko_store_id}}/inventory?page=0&size=100&sort=nameAsc
Authorization: Bearer {{marko_token}}
Accept: application/json

> {%
    const productIds =
        response.body.content
            ? response.body.content.map(
                item => item.product.id
            )
            : [];

    client.global.set(
        "marko_inventory_product_ids",
        JSON.stringify(productIds)
    );
%}


### ========================================================
### SEARCH MARKO INVENTORY
### Expected: 200
### ========================================================

GET {{baseUrl}}/api/store/stores/{{marko_store_id}}/inventory?q=coca&page=0&size=20&sort=nameAsc
Authorization: Bearer {{marko_token}}
Accept: application/json


### ========================================================
### SORT INVENTORY BY PRICE ASCENDING
### Expected: 200
### ========================================================

GET {{baseUrl}}/api/store/stores/{{marko_store_id}}/inventory?page=0&size=20&sort=priceAsc
Authorization: Bearer {{marko_token}}
Accept: application/json


### ========================================================
### SORT INVENTORY BY PRICE DESCENDING
### Expected: 200
### ========================================================

GET {{baseUrl}}/api/store/stores/{{marko_store_id}}/inventory?page=0&size=20&sort=priceDesc
Authorization: Bearer {{marko_token}}
Accept: application/json


### ========================================================
### SORT INVENTORY BY LAST UPDATE
### Expected: 200
### ========================================================

GET {{baseUrl}}/api/store/stores/{{marko_store_id}}/inventory?page=0&size=20&sort=updatedDesc
Authorization: Bearer {{marko_token}}
Accept: application/json


### ========================================================
### STORE OWNER PRODUCT CATALOG
### Select a product not already present in Marko's inventory
### Expected: 200
### ========================================================

GET {{baseUrl}}/api/store/catalog/products?page=0&size=100
Authorization: Bearer {{marko_token}}
Accept: application/json

> {%
    const inventoryProductIds =
        JSON.parse(
            client.global.get(
                "marko_inventory_product_ids"
            ) || "[]"
        );

    const products =
        response.body.content || [];

    const candidate =
        products.find(
            product =>
                !inventoryProductIds.includes(
                    product.id
                )
        );

    if (!candidate) {
        throw new Error(
            "No catalog product is available for the inventory creation test."
        );
    }

    client.global.set(
        "store_test_product_id",
        candidate.id
    );
%}


### ========================================================
### ADD TEST PRODUCT TO MARKO INVENTORY
### Expected: 201
### ========================================================

POST {{baseUrl}}/api/store/stores/{{marko_store_id}}/inventory
Authorization: Bearer {{marko_token}}
Content-Type: application/json

{
  "productId": {{store_test_product_id}},
  "price": 69.00,
  "quantity": 15,
  "status": "IN_STOCK"
}

> {%
    if (
        response.status === 201
    ) {
        client.global.set(
            "store_test_inventory_id",
            response.body.id
        );
    }
%}


### ========================================================
### ADD DUPLICATE INVENTORY ITEM
### Expected: 409
### ========================================================

POST {{baseUrl}}/api/store/stores/{{marko_store_id}}/inventory
Authorization: Bearer {{marko_token}}
Content-Type: application/json

{
  "productId": {{store_test_product_id}},
  "price": 71.00,
  "quantity": 10,
  "status": "IN_STOCK"
}


### ========================================================
### UPDATE TEST INVENTORY ITEM
### Expected: 200
### ========================================================

PUT {{baseUrl}}/api/store/stores/{{marko_store_id}}/inventory/{{store_test_inventory_id}}
Authorization: Bearer {{marko_token}}
Content-Type: application/json

{
  "price": 72.50,
  "quantity": 8,
  "status": "LOW_STOCK"
}


### ========================================================
### INVALID INVENTORY STATE
### Quantity 0 must be OUT_OF_STOCK
### Expected: 400
### ========================================================

PUT {{baseUrl}}/api/store/stores/{{marko_store_id}}/inventory/{{store_test_inventory_id}}
Authorization: Bearer {{marko_token}}
Content-Type: application/json

{
  "price": 72.50,
  "quantity": 0,
  "status": "IN_STOCK"
}


### ========================================================
### INVALID INVENTORY STATE
### OUT_OF_STOCK cannot have positive quantity
### Expected: 400
### ========================================================

PUT {{baseUrl}}/api/store/stores/{{marko_store_id}}/inventory/{{store_test_inventory_id}}
Authorization: Bearer {{marko_token}}
Content-Type: application/json

{
  "price": 72.50,
  "quantity": 10,
  "status": "OUT_OF_STOCK"
}


### ========================================================
### VALID OUT OF STOCK UPDATE
### Expected: 200
### ========================================================

PUT {{baseUrl}}/api/store/stores/{{marko_store_id}}/inventory/{{store_test_inventory_id}}
Authorization: Bearer {{marko_token}}
Content-Type: application/json

{
  "price": 72.50,
  "quantity": 0,
  "status": "OUT_OF_STOCK"
}


### ========================================================
### RESTORE TEST ITEM TO LOW STOCK
### Expected: 200
### ========================================================

PUT {{baseUrl}}/api/store/stores/{{marko_store_id}}/inventory/{{store_test_inventory_id}}
Authorization: Bearer {{marko_token}}
Content-Type: application/json

{
  "price": 72.50,
  "quantity": 5,
  "status": "LOW_STOCK"
}


### ========================================================
### INVALID NEGATIVE PRICE
### Expected: 400
### ========================================================

PUT {{baseUrl}}/api/store/stores/{{marko_store_id}}/inventory/{{store_test_inventory_id}}
Authorization: Bearer {{marko_token}}
Content-Type: application/json

{
  "price": -10.00,
  "quantity": 5,
  "status": "LOW_STOCK"
}


### ========================================================
### NON-EXISTING PRODUCT
### Expected: 404
### ========================================================

POST {{baseUrl}}/api/store/stores/{{marko_store_id}}/inventory
Authorization: Bearer {{marko_token}}
Content-Type: application/json

{
  "productId": 999999999,
  "price": 100.00,
  "quantity": 5,
  "status": "IN_STOCK"
}


