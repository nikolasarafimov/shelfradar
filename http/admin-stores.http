@baseUrl = http://localhost:8080


### Admin login

POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@shelfradar.local",
  "password": "Admin123!"
}

> {%
    client.global.set(
        "admin_token",
        response.body.accessToken
    );
%}


### Dashboard

GET {{baseUrl}}/api/admin/dashboard
Authorization: Bearer {{admin_token}}


### All stores

GET {{baseUrl}}/api/admin/stores?page=0&size=20
Authorization: Bearer {{admin_token}}


### Active stores

GET {{baseUrl}}/api/admin/stores?status=ACTIVE
Authorization: Bearer {{admin_token}}


### Pending stores

GET {{baseUrl}}/api/admin/stores?status=PENDING
Authorization: Bearer {{admin_token}}


### Search stores / owners

GET {{baseUrl}}/api/admin/stores?q=Market
Authorization: Bearer {{admin_token}}


### Filters

GET {{baseUrl}}/api/admin/stores/filters
Authorization: Bearer {{admin_token}}


### Store owners

GET {{baseUrl}}/api/admin/store-owners
Authorization: Bearer {{admin_token}}


### Store detail

GET {{baseUrl}}/api/admin/stores/1
Authorization: Bearer {{admin_token}}


### Activate store

PATCH {{baseUrl}}/api/admin/stores/1/status
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "status": "ACTIVE"
}


### Store owner must NOT access admin endpoints

POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "marko@shelfradar.local",
  "password": "Store123!"
}

> {%
    client.global.set(
        "owner_token",
        response.body.accessToken
    );
%}


### Expected 403

GET {{baseUrl}}/api/admin/dashboard
Authorization: Bearer {{owner_token}}