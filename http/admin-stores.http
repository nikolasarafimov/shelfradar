@baseUrl = http://localhost:8080


### ========================================================
### ADMIN LOGIN
### Expected: 200
### ========================================================

POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@shelfradar.local",
  "password": "Admin123!"
}

> {%
    client.global.set(
        "admin_stores_token",
        response.body.accessToken
    );
%}


### ========================================================
### ADMIN DASHBOARD
### Expected: 200
### ========================================================

GET {{baseUrl}}/api/admin/dashboard
Authorization: Bearer {{admin_stores_token}}
Accept: application/json


### ========================================================
### ALL STORES
### Expected: 200
### ========================================================

GET {{baseUrl}}/api/admin/stores?page=0&size=20&sort=newest
Authorization: Bearer {{admin_stores_token}}
Accept: application/json


### ========================================================
### ACTIVE STORES
### Expected: 200
### ========================================================

GET {{baseUrl}}/api/admin/stores?status=ACTIVE&page=0&size=20
Authorization: Bearer {{admin_stores_token}}
Accept: application/json


### ========================================================
### PENDING STORES
### Expected: 200
### ========================================================

GET {{baseUrl}}/api/admin/stores?status=PENDING&page=0&size=20
Authorization: Bearer {{admin_stores_token}}
Accept: application/json


### ========================================================
### STORES IN SKOPJE
### Expected: 200
### ========================================================

GET {{baseUrl}}/api/admin/stores?city=Skopje&page=0&size=20&sort=nameAsc
Authorization: Bearer {{admin_stores_token}}
Accept: application/json


### ========================================================
### SEARCH FOR MARKET CENTER
### Expected: 200
### Saves store ID and owner ID for later requests
### ========================================================

GET {{baseUrl}}/api/admin/stores?q=Market%20Center&page=0&size=20&sort=nameAsc
Authorization: Bearer {{admin_stores_token}}
Accept: application/json

> {%
    const stores =
        response.body.content || [];

    const marketCenter =
        stores.find(
            store =>
                store.name === "Market Center"
        );

    if (!marketCenter) {
        throw new Error(
            "Market Center was not found."
        );
    }

    client.global.set(
        "admin_test_store_id",
        marketCenter.id
    );

    client.global.set(
        "admin_test_store_owner_id",
        marketCenter.owner.id
    );
%}


### ========================================================
### STORE FILTERS
### Expected: 200
### ========================================================

GET {{baseUrl}}/api/admin/stores/filters
Authorization: Bearer {{admin_stores_token}}
Accept: application/json


### ========================================================
### STORE OWNERS
### Expected: 200
### ========================================================

GET {{baseUrl}}/api/admin/store-owners
Authorization: Bearer {{admin_stores_token}}
Accept: application/json


### ========================================================
### STORE DETAIL
### Expected: 200
### ========================================================

GET {{baseUrl}}/api/admin/stores/{{admin_test_store_id}}
Authorization: Bearer {{admin_stores_token}}
Accept: application/json


### ========================================================
### UPDATE STORE
### Expected: 200
### Uses the current seeded Market Center profile
### ========================================================

PUT {{baseUrl}}/api/admin/stores/{{admin_test_store_id}}
Authorization: Bearer {{admin_stores_token}}
Content-Type: application/json

{
  "name": "Market Center",
  "address": "Macedonia Square 1",
  "city": "Skopje",
  "latitude": 41.998100,
  "longitude": 21.425400,
  "phone": "+389 2 555 1001",
  "workingHours": "Mon-Sun 08:00-22:00",
  "ownerId": {{admin_test_store_owner_id}}
}


### ========================================================
### SET STORE STATUS TO ACTIVE
### Expected: 200
### Non-destructive for the seeded Market Center
### ========================================================

PATCH {{baseUrl}}/api/admin/stores/{{admin_test_store_id}}/status
Authorization: Bearer {{admin_stores_token}}
Content-Type: application/json

{
  "status": "ACTIVE"
}


### ========================================================
### INVALID STORE ID
### Expected: 400
### ========================================================

GET {{baseUrl}}/api/admin/stores/0
Authorization: Bearer {{admin_stores_token}}
Accept: application/json


### ========================================================
### STORE OWNER LOGIN
### Expected: 200
### ========================================================

POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "marko@shelfradar.local",
  "password": "Store123!"
}

> {%
    client.global.set(
        "admin_stores_owner_token",
        response.body.accessToken
    );
%}


### ========================================================
### STORE OWNER TRIES ADMIN DASHBOARD
### Expected: 403
### ========================================================

GET {{baseUrl}}/api/admin/dashboard
Authorization: Bearer {{admin_stores_owner_token}}
Accept: application/json


### ========================================================
### ADMIN RESOURCE WITHOUT TOKEN
### Expected: 401
### ========================================================

GET {{baseUrl}}/api/admin/dashboard
Accept: application/json