@baseUrl = http://localhost:8080

### ========================================================
### ADMIN LOGIN
### Expected: 200
### ========================================================

POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@shelfradar.local",
  "password": "Admin123!"
}

> {%
    client.global.set(
        "admin_token",
        response.body.accessToken
    );
%}


### ========================================================
### CURRENT ADMIN
### Expected: 200
### ========================================================

GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{admin_token}}


### ========================================================
### STORE OWNER LOGIN
### Expected: 200
### ========================================================

POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "marko@shelfradar.local",
  "password": "Store123!"
}

> {%
    client.global.set(
        "store_token",
        response.body.accessToken
    );
%}


### ========================================================
### CURRENT STORE OWNER
### Expected: 200
### ========================================================

GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{store_token}}


### ========================================================
### INVALID LOGIN
### Expected: 401
### ========================================================

POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@shelfradar.local",
  "password": "wrong-password"
}


### ========================================================
### UNKNOWN USER
### Expected: 401
### ========================================================

POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "unknown@shelfradar.local",
  "password": "Unknown123!"
}


### ========================================================
### CURRENT USER WITHOUT TOKEN
### Expected: 401
### ========================================================

GET {{baseUrl}}/api/auth/me


### ========================================================
### CURRENT USER WITH INVALID TOKEN
### Expected: 401
### ========================================================

GET {{baseUrl}}/api/auth/me
Authorization: Bearer invalid-token