@baseUrl = http://localhost:8080


### ========================================================
### STORE OWNER LOGIN
### Expected: 200
### ========================================================

POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "marko@shelfradar.local",
  "password": "Store123!"
}

> {%
    client.global.set(
        "dashboard_store_token",
        response.body.accessToken
    );
%}


### ========================================================
### OWNER DASHBOARD
### Expected: 200
### ========================================================

GET {{baseUrl}}/api/store/dashboard
Authorization: Bearer {{dashboard_store_token}}
Accept: application/json

> {%
    if (
        response.body.stores &&
        response.body.stores.length > 0
    ) {
        client.global.set(
            "dashboard_store_id",
            response.body.stores[0].store.id
        );
    }
%}


### ========================================================
### STORE DASHBOARD
### Expected: 200
### ========================================================

GET {{baseUrl}}/api/store/stores/{{dashboard_store_id}}/dashboard
Authorization: Bearer {{dashboard_store_token}}
Accept: application/json


### ========================================================
### ADMIN LOGIN
### Expected: 200
### ========================================================

POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@shelfradar.local",
  "password": "Admin123!"
}

> {%
    client.global.set(
        "dashboard_admin_token",
        response.body.accessToken
    );
%}


### ========================================================
### ADMIN TRIES OWNER DASHBOARD
### Expected: 403
### ========================================================

GET {{baseUrl}}/api/store/dashboard
Authorization: Bearer {{dashboard_admin_token}}
Accept: application/json


### ========================================================
### OWNER DASHBOARD WITHOUT TOKEN
### Expected: 401
### ========================================================

GET {{baseUrl}}/api/store/dashboard
Accept: application/json


### ========================================================
### STORE DASHBOARD WITH INVALID STORE ID
### Expected: 400
### ========================================================

GET {{baseUrl}}/api/store/stores/0/dashboard
Authorization: Bearer {{dashboard_store_token}}
Accept: application/json