@baseUrl = http://localhost:8080


### ========================================================
### ADMIN LOGIN
### Expected: 200
### ========================================================

POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@shelfradar.local",
  "password": "Admin123!"
}

> {%
    client.global.set(
        "audit_admin_token",
        response.body.accessToken
    );
%}


### ========================================================
### ADMIN ANALYTICS
### Expected: 200
### ========================================================

GET {{baseUrl}}/api/admin/analytics
Authorization: Bearer {{audit_admin_token}}
Accept: application/json


### ========================================================
### FULL AUDIT LOG
### Expected: 200
### ========================================================

GET {{baseUrl}}/api/admin/audit?page=0&size=20
Authorization: Bearer {{audit_admin_token}}
Accept: application/json


### ========================================================
### INVENTORY AUDIT EVENTS
### Expected: 200
### ========================================================

GET {{baseUrl}}/api/admin/audit?entityType=INVENTORY&page=0&size=20
Authorization: Bearer {{audit_admin_token}}
Accept: application/json


### ========================================================
### STORE AUDIT EVENTS
### Expected: 200
### ========================================================

GET {{baseUrl}}/api/admin/audit?entityType=STORE&page=0&size=20
Authorization: Bearer {{audit_admin_token}}
Accept: application/json


### ========================================================
### STORE STATUS CHANGES
### Expected: 200
### ========================================================

GET {{baseUrl}}/api/admin/audit?action=STORE_STATUS_CHANGED&page=0&size=20
Authorization: Bearer {{audit_admin_token}}
Accept: application/json


### ========================================================
### SEARCH AUDIT LOG
### Expected: 200
### ========================================================

GET {{baseUrl}}/api/admin/audit?q=Market&page=0&size=20
Authorization: Bearer {{audit_admin_token}}
Accept: application/json


### ========================================================
### COMBINED AUDIT FILTERS
### Expected: 200
### ========================================================

GET {{baseUrl}}/api/admin/audit?q=Market&entityType=STORE&page=0&size=20
Authorization: Bearer {{audit_admin_token}}
Accept: application/json